# lnc-notebooklm stack env — copy to stack.env in Portainer, fill real values.
# Secrets stay here ONLY, never in the repo.

# Admin UI login key (also seeds HMAC session signing). Required in prod.
MANAGEMENT_KEY=

# Comma-separated API keys for Bearer auth on /mcp + /api/files + /api/status.
# Mint one per consumer (per-agent), keep them distinct for revoke.
LNC_API_KEYS=nblm_xxx1,nblm_xxx2

# Host port mapping (container always listens 8000 internally)
PORT=8472

# Optional: external base URL surfaced to clients (download_url generation)
# PUBLIC_BASE_URL=http://notebooklm.lengoc.me

# Max upload size for POST /api/files (MB)
# MAX_UPLOAD_MB=200
